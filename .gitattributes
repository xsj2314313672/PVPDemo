# 默认按文本处理并自动归一化行尾
* text=auto

# 文本文件：统一 LF，避免跨平台行尾污染
*.cpp   text eol=lf
*.h     text eol=lf
*.cs    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.ini   text eol=lf
*.uproject text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf

# 二进制资源：禁止任何换行转换与 diff
*.uasset  binary
*.umap    binary
*.ubulk    binary
*.uexp    binary
*.upk     binary
*.udk     binary

# 其它二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.bmp  binary
*.exr  binary
*.hdr  binary
*.wav  binary
*.fbx  binary
*.dll  binary
*.exe  binary
*.lib  binary
*.pdb  binary
